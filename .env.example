# Copy to .env, replace every CHANGE_ME value with an independent random secret,
# then keep .env out of version control. Application secrets must be at least 43
# printable ASCII characters. Use URI-safe hexadecimal or base64url for the raw
# DATABASE_URL password interpolation. Do not reuse values between variables.
POSTGRES_DB=api_usage
POSTGRES_USER=api_usage
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
SYSTEM_ADMIN_TOKEN=CHANGE_ME_SYSTEM_ADMIN_TOKEN
API_KEY_PEPPER=CHANGE_ME_API_KEY_PEPPER
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN
PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=true
